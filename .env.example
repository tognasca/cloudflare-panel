# Copy to .env (never commit the real file)
POSTGRES_PASSWORD=change-me-before-running
JWT_SECRET=replace-with-long-random-secret
# Required for hosted OAuth; DISABLE_AUTH is never allowed in production
OAUTH_SERVER_URL=
VITE_APP_ID=
# Optional: configure via Cloudflare settings in the application
TUNNEL_ID=
TUNNEL_CREDENTIALS=
CLOUDFLARED_BIN=cloudflared
TUNNEL_CONFIG_PATH=./tunnel.yml
